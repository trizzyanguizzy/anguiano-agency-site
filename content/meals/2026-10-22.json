            {
              "qty": "to taste",
              "name": "Salt",
              "group": "Green beans"
            }
          ],
          "steps": [
            {
              "group": "Start",
              "text": "Take the filets out of the fridge 30–45 minutes before cooking. Pat dry and salt all over."
            },
            {
              "group": "Potatoes",
              "text": "Cover the potatoes with cold salted water, bring to a boil, and cook until a fork slides in easily.",
              "minutes": 18
            },
            {
              "group": "Start",
              "text": "Heat the oven to 400°F."
            },
            {
              "group": "Steak",
              "text": "Heat a cast-iron or oven-safe skillet over high until it just smokes. Add the oil, then the filets. Sear without moving.",
              "minutes": 3
            },
            {
              "group": "Steak",
              "text": "Flip and sear the second side. Hold each filet on its edge for 30 seconds to brown the sides too.",
              "minutes": 3
            },
            {
              "group": "Steak",
              "text": "Add the butter and smashed garlic. Tilt the pan and spoon the foaming butter over the steaks.",
              "minutes": 1
            },
            {
              "group": "Steak",
              "text": "Move the skillet to the oven until the center reads 125°F for medium-rare (130°F medium).",
              "minutes": 6
            },
            {
              "group": "Steak",
              "text": "Rest the steaks on a plate, loosely tented with foil. They'll rise about 5°F.",
              "minutes": 8
            },
            {
              "group": "Potatoes",
              "text": "While the steak cooks, drain the potatoes and return to the pot. Add the butter, garlic, milk or yogurt, salt, and pepper, and smash to your liking."
            },
            {
              "group": "Green beans",
              "text": "Sauté the green beans in oil over medium-high, tossing, until bright and blistered. Add the garlic for the last 30 seconds and salt.",
              "minutes": 7
            },
            {
              "group": "Serve",
              "text": "Plate everything and spoon the garlic butter from the skillet over the steaks."
            }
          ],
          "tips": [
            "An instant-read thermometer is the difference between perfect and overcooked on a filet.",
            "Skillet handle comes out of the oven very hot. Leave a towel on it."
          ]
        }
      }
