              "qty": "1 lb, trimmed",
              "name": "Green beans",
              "group": "Green beans"
            },
            {
              "qty": "1 tbsp",
              "name": "Olive oil",
              "group": "Green beans"
            },
            {
              "qty": "1 clove, minced",
              "name": "Garlic",
              "group": "Green beans"
